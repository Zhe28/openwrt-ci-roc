### 通用配置文件 ###

CONFIG_DEVEL=y
CONFIG_CCACHE=y
CONFIG_PACKAGE_default-settings=y
CONFIG_PACKAGE_default-settings-chn=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
# 繁体中文语言包已关闭；简体中文由上游自动开启（实测官方雅典娜构建的最终 .config 里 CONFIG_LUCI_LANG_zh_Hans=y）
CONFIG_LUCI_LANG_zh_Hant=n

# CONFIG_FEED_video is not set
# CONFIG_FEED_nss_packages is not set
# CONFIG_FEED_sqm_scripts_nss is not set
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set

CONFIG_PACKAGE_zram-swap=y
# 下面三行会写进内核 .config，从而改变 vermagic（内核配置 MD5），导致官方源的 kmod-* 装不上，已移除
# 官方源里 kmod 的依赖是 kernel (= <版本>~<vermagic>-r<release>)，见 include/kernel.mk:216
CONFIG_PACKAGE_kmod-lib-lz4=y

CONFIG_PACKAGE_tmux=y
CONFIG_PACKAGE_dmesg=y
CONFIG_PACKAGE_btop=y
CONFIG_PACKAGE_fstrim=y
CONFIG_PACKAGE_autocore=y
CONFIG_PACKAGE_coremark=y
CONFIG_PACKAGE_zoneinfo-asia=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_sqm-scripts-nss=n

CONFIG_PACKAGE_luci-theme-aurora=y
CONFIG_PACKAGE_luci-app-aurora-config=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_luci-app-vlmcsd=y
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-app-cpufreq=y
CONFIG_PACKAGE_luci-app-3cat=y
CONFIG_PACKAGE_luci-app-watchcat=y
CONFIG_PACKAGE_luci-app-wechatpush=y

### 数据库与运行时（redis / postgres / mysql / node / python）###
### 包名对照：mysql 官方源里没有本体，用的是 mariadb；postgres 的包名是 pgsql-*；###
### node 的产物名带 ABI 版本（node127），但 config 符号仍写 node ###
CONFIG_PACKAGE_redis-server=y
CONFIG_PACKAGE_redis-cli=y
# pgvector：官方包源无现成包，本仓库自带独立小包（scripts/packages/pgvector），
# 构建时由 scripts/Roc-script.sh 拷入 package/pgvector，从钉住的 pgvector 源码
# 交叉编译 vector.so（链 pgsql-server staged 的服务端头文件，只需几分钟）；
# 装好后需在库内执行 CREATE EXTENSION vector; 启用
# mariadb 11.8 原生支持 VECTOR 字段类型与向量检索，无需额外扩展
CONFIG_PACKAGE_pgsql-server=y
CONFIG_PACKAGE_pgsql-cli=y
CONFIG_PACKAGE_pgvector=y
CONFIG_PACKAGE_mariadb-server=y
CONFIG_PACKAGE_mariadb-client=y
# node 已换用 scripts/packages/node：Node.js 社区 unofficial-builds 的 musl 预编译二进制
# wrapper，不再交叉编译 V8（单组约 3 小时 -> 几分钟）；版本在 wrapper 里钉死 22.23.4
# （ABI 127，与官方源 node-* 模块包一致），包里不再有 NODEJS_22/24/26 选择项
CONFIG_PACKAGE_node=y
CONFIG_PACKAGE_node-npm=y
# python3 是全模块元包（含 sqlite3/ctypes/ssl/xml 等）；只要解释器可换成 CONFIG_PACKAGE_python3-light=y
CONFIG_PACKAGE_python3=y
CONFIG_PACKAGE_python3-pip=y

### 明确关闭的插件 ###
### 不需要的软件包必须把 y 改成 n，仅在前面添加 # 是无效的 ###

CONFIG_PACKAGE_luci-theme-argon=n
CONFIG_PACKAGE_luci-app-argon-config=n
CONFIG_PACKAGE_luci-app-banip=n
CONFIG_PACKAGE_luci-app-arpbind=n
CONFIG_PACKAGE_luci-app-usb-printer=n
CONFIG_PACKAGE_luci-app-oaf=n
CONFIG_PACKAGE_luci-app-sqm=n
CONFIG_PACKAGE_luci-app-ttyd=n
CONFIG_PACKAGE_luci-app-smartdns=n
CONFIG_PACKAGE_luci-app-lucky=n
CONFIG_PACKAGE_luci-app-openclash=n
CONFIG_PACKAGE_luci-app-passwall2=n
CONFIG_PACKAGE_luci-app-wifischedule=n

### 本机（京东云雅典娜 RE-CS-02）不需要，已从上面移到此处 ###

CONFIG_PACKAGE_luci-app-acme=n
CONFIG_PACKAGE_luci-app-diskman=n
CONFIG_PACKAGE_luci-app-hd-idle=n
CONFIG_PACKAGE_luci-proto-wireguard=n
CONFIG_PACKAGE_htop=n
CONFIG_PACKAGE_fdisk=n
CONFIG_PACKAGE_cfdisk=n
CONFIG_PACKAGE_sgdisk=n
CONFIG_PACKAGE_hdparm=n
CONFIG_PACKAGE_smartmontools-drivedb=n
CONFIG_PACKAGE_tune2fs=n
CONFIG_PACKAGE_nano-full=n
CONFIG_PACKAGE_acme-acmesh-dnsapi=n
CONFIG_PACKAGE_ddns-scripts-cloudflare=n
# 三条雅典娜构建已把 LuCI 交给 nginx，uhttpd 的设置页留着没意义（x86-64 那条靠下面显式的 uhttpd 跑界面）
CONFIG_PACKAGE_luci-app-uhttpd=n

### 透明代理：homeproxy + sing-box（替代 PassWall，精简单核心） ###
### 依赖自动带出：sing-box、firewall4、kmod-nft-tproxy、ucode-mod-digest（ucode 在主树 package/utils/ucode）###
CONFIG_PACKAGE_luci-app-homeproxy=y
CONFIG_PACKAGE_sing-box=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
### PassWall 全家桶已关闭（18 个核心库随之下架；frp 同样删除）###
CONFIG_PACKAGE_luci-app-passwall=n
CONFIG_PACKAGE_luci-app-passwall_Nftables_Transparent_Proxy=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Geoview=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray=n
CONFIG_PACKAGE_luci-app-frps=n
CONFIG_PACKAGE_luci-app-frpc=n
