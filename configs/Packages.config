### OpenWrt SDK软件包编译配置项 ###

CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_LUCI_LANG_zh_Hant=y

CONFIG_PACKAGE_frpc=y
CONFIG_PACKAGE_frps=y
CONFIG_PACKAGE_gecoosac=y
CONFIG_PACKAGE_nginx-full=y
CONFIG_PACKAGE_openlist2=y
CONFIG_PACKAGE_lucky=y
CONFIG_PACKAGE_luci-app-aria2=y
CONFIG_PACKAGE_luci-app-frpc=y
CONFIG_PACKAGE_luci-app-frps=y
CONFIG_PACKAGE_luci-app-gecoosac=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-app-aurora-config=y
CONFIG_PACKAGE_luci-app-lucky=y
CONFIG_PACKAGE_luci-app-openlist2=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-theme-aurora=y

### 数据库与运行时（SDK 流水线只带编译代价轻的 redis / pgsql）###
### node、python3、mariadb 没有放进流水线：单个包就要编 20~90 分钟，而 Build-Packages.yml
### 每个 matrix job 的 timeout-minutes 是 180，加上它们会把 job 编爆。固件构建里已经带上。###
CONFIG_PACKAGE_redis-server=y
CONFIG_PACKAGE_redis-cli=y
CONFIG_PACKAGE_pgsql-server=y
CONFIG_PACKAGE_pgsql-cli=y

### Aria2配置项 ###

CONFIG_PACKAGE_aria2=y
CONFIG_PACKAGE_ariang=y

CONFIG_ARIA2_OPENSSL=y
# CONFIG_ARIA2_GNUTLS is not set
# CONFIG_ARIA2_NOSSL is not set
# CONFIG_ARIA2_LIBXML2 is not set
CONFIG_ARIA2_EXPAT=y
# CONFIG_ARIA2_NOXML is not set
CONFIG_ARIA2_BITTORRENT=y
CONFIG_ARIA2_METALINK=y
CONFIG_ARIA2_SFTP=y
CONFIG_ARIA2_ASYNC_DNS=y
# CONFIG_ARIA2_COOKIE is not set
CONFIG_ARIA2_WEBSOCKET=y
